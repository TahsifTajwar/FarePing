NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fareping?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/fareping?sslmode=require

# Flight API credentials will go here when we choose the provider.
FLIGHT_PROVIDER=mock
SCHEDULED_FLIGHT_PROVIDER=mock
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_API_KEY=
MAX_SERPAPI_DATE_PAIRS=10
SERPAPI_COMPARE_SPLIT_ONE_WAYS=true
SERPAPI_ROUND_TRIP_OUTBOUND_OPTIONS=8
SERPAPI_ROUND_TRIP_RETURN_OPTIONS=6
SERPAPI_SPLIT_OPTIONS_PER_SIDE=6
SERPAPI_SHOW_HIDDEN=true
MIN_VISIBLE_DEAL_SCORE=600

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI trip assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_USE_TRIAL_TEMPLATE=false
